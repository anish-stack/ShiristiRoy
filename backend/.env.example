# ====== SERVER ======
NODE_ENV=development
PORT=5000
API_VERSION=v1
CLIENT_URL=http://localhost:3000

# ====== MONGODB ======
MONGO_URI=mongodb://localhost:27017/srishti_therapy
MONGO_URI_TEST=mongodb://localhost:27017/srishti_therapy_test

# ====== REDIS ======
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# ====== JWT ======
JWT_ACCESS_SECRET=replace_with_64_char_random_string
JWT_REFRESH_SECRET=replace_with_different_64_char_random_string
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
JWT_ISSUER=srishti.therapy

# ====== EMAIL (Nodemailer / SMTP) ======
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=roysrishti010@gmail.com
SMTP_PASS=app_password_here
EMAIL_FROM="Srishti Roy <contact@awakentherapy.in>"

# ====== CLOUDINARY ======
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ====== RAZORPAY ======
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# ====== SECURITY ======
BCRYPT_ROUNDS=12
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100
CORS_ORIGINS=http://localhost:3000,https://awakenwithsrishti.com

# ====== BOOKING CONCURRENCY ======
SLOT_LOCK_TTL_MS=10000
SLOT_LOCK_RETRY_COUNT=3
SLOT_LOCK_RETRY_DELAY_MS=200
